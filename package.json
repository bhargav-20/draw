{
  "name": "excalidraw-projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/copy-fonts.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:app": "vitest --watch=false",
    "test:typecheck": "tsc",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx src",
    "test:other": "yarn prettier --list-different",
    "test:all": "yarn test:typecheck && yarn test:code && yarn test:other && yarn test:app",
    "fix:code": "yarn test:code --fix",
    "fix:other": "yarn prettier --write",
    "fix": "yarn fix:other && yarn fix:code",
    "prettier": "prettier \"**/*.{ts,tsx,css,scss,json,md,html,yml}\" --ignore-path=.gitignore",
    "copy:fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "node scripts/copy-fonts.mjs",
    "postbuild": "cp dist/index.html dist/404.html"
  },
  "prettier": "@excalidraw/prettier-config",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "idb": "8.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.9.1"
  },
  "devDependencies": {
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "3.3.1",
    "fake-indexeddb": "6.0.1",
    "jsdom": "26.1.0",
    "prettier": "2.6.2",
    "sass": "1.89.2",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4",
    "vitest-canvas-mock": "0.3.3"
  }
}
